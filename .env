PORT=3001
VIDEO_FILE=./ppe-upload-video-new1.mp4
AUTO_START_PROCESSING=true

# Camera settings
USE_CAMERA=true
CAMERA_DEVICE=/dev/video0

ROBOFLOW_API_KEY=jlY9qpN7ZBI9Ay5V1xEW
ROBOFLOW_MODEL=ppe-detection-soydn-wdpr0
ROBOFLOW_VERSION=1

# OPTIMIZED: Better confidence thresholds (higher = fewer false positives)
ROBOFLOW_CONFIDENCE=0.5
ROBOFLOW_OVERLAP=0.3

# OPTIMIZED: Process every 2nd frame = 50% faster with good accuracy
FRAME_SAMPLE_RATE=2

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_PLATE_API_URL=http://localhost:5001
VITE_PLATE_API_TOKEN=5e9a601bcba4c28325262c42d13bc295c18b492b

# Video Analytics Configuration
VITE_ANALYTICS_API_URL=http://localhost:5002

# Speed Detection Calibration
# PIXELS_PER_METER: Calibrate by measuring a known distance in the video
# Example: If a 5-meter object appears as 50 pixels, set to 10
PIXELS_PER_METER=10.0

# Frame rate of the video (fps)
FRAME_RATE=30.0

# Speed threshold for flagging vehicles as speeding (km/h)
MIN_SPEED_THRESHOLD=50.0

# YOLO confidence threshold (0.0 - 1.0)
YOLO_CONF=0.45

# Video processing sample rate (process every nth frame)
VIDEO_SAMPLE_RATE=2

# Video Analytics Port
VIDEO_ANALYTICS_PORT=5002

